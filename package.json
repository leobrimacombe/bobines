{
  "name": "spooltracker",
  "productName": "SpoolTracker",
  "version": "1.0.0",
  "description": "Gestion du stock de bobines de filament 3D",
  "author": "Léo Brimacombe",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:test": "npm run build && electron-builder --dir",
    "lint": "eslint"
  },
  "//": "Tout est en devDependencies : l'appli Electron n'embarque que le serveur Next autonome (.next/standalone), pas node_modules",
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
